<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The standard-only helper/location/vendor permissions are not declared in this flavor. -->
    <application android:label="@string/canf55_app_name" tools:replace="android:label">
        <service android:name=".HomeKeyService" tools:node="remove" />
        <service android:name=".InputKeyService" tools:node="remove" />
        <service android:name=".GuardRevival" tools:node="remove" />
        <receiver android:name=".GuardConfig" tools:node="remove" />
        <activity android:name=".ProbeActivity" tools:node="remove" />
        <activity android:name=".MainActivity" android:exported="true">
            <!-- Ordinary Android HOME firmware may not list LEANBACK_LAUNCHER apps. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
